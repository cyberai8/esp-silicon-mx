{
    "manufacturer": "espressif",
    "type": "esp32-s31-korvo-1",
    "target": "esp32s31",
    "preview": true,
    "builds": [
        {
            "name": "esp32-s31-korvo-1",
            "idf_version": ">=6.1",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v1/16m_claw4_s31.csv\"",
                "CONFIG_CAMERA_OV3660=y",
                "CONFIG_MBEDTLS_HARDWARE_AES=n",
                "CONFIG_MBEDTLS_HARDWARE_GCM=n",
                "CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n",
                "CONFIG_WAKE_WORD_DISABLED=n",
                "CONFIG_USE_ESP_WAKE_WORD=y",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_SEND_WAKE_WORD_DATA=n",
                "CONFIG_SR_WN_WN9_HITELLY_TTS=y",
                "CONFIG_USE_AUDIO_PROCESSOR=n",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y",
                "CONFIG_BT_BLUEDROID_ENABLED=y",
                "CONFIG_BT_CLASSIC_ENABLED=y",
                "CONFIG_BT_BLE_ENABLED=n",
                "CONFIG_BT_A2DP_ENABLE=y",
                "CONFIG_BT_CTRL_BR_EDR_MAX_ACL_CONN=1",
                "CONFIG_BT_CTRL_BR_EDR_ACLU_TX_BUF_NB=3",
                "CONFIG_BT_CTRL_BR_EDR_ACLU_RX_BUF_NB=4",
                "CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y",
                "CONFIG_BT_BLUEDROID_TASK_STACK_IN_EXT_MEM=y",
                "CONFIG_BT_BLUEDROID_BTU_TASK_STACK_IN_EXT_MEM=y",
                "CONFIG_BT_BLUEDROID_HCI_TASK_STACK_IN_EXT_MEM=y",
                "CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n",
                "CONFIG_BT_GOEPC_ENABLED=n"
            ]
        }
    ]
}
