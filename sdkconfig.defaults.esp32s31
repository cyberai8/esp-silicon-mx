# ESP32-S31-Korvo-1（16MB Flash + 16MB PSRAM）
# 对齐小智官方 sdkconfig.defaults.esp32s31 + MetalioClaw4 分区/板选项
#   export IDF_PATH=.../esp-idf-s31-fresh
#   idf.py --preview -B build-esp32s31 set-target esp32s31
#   idf.py --preview -B build-esp32s31 build

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v1/16m_claw4_s31.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# S31 上 MQTT/TLS 启动期内部 RAM 紧张，硬件 AES 路径会触发 esp-aes
# 内部对象分配失败；TLS 走软件 AES，换启动稳定性。
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_GCM=n

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_BOARD_TYPE_ESP32_S31_KORVO_1=y

# Classic BT: GCC16 + IDF6.2 bluedroid currently fails -Werror=stringop-truncation.
# Screen/WiFi bring-up first; re-enable after flag/order fix.
# CONFIG_BT_ENABLED is not set

CONFIG_WAKE_WORD_DISABLED=n
CONFIG_USE_ESP_WAKE_WORD=y
CONFIG_USE_AFE_WAKE_WORD=n
CONFIG_SEND_WAKE_WORD_DATA=n
CONFIG_SR_WN_WN9_HITELLY_TTS=y
CONFIG_USE_AUDIO_PROCESSOR=n

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096
CONFIG_CAMERA_OV3660=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# LVGL: emoji fonts in 78/xiaozhi-fonts need imgfont
CONFIG_LV_USE_IMGFONT=y
# Large CJK fonts exceed 20-bit bitmap_index; need 32-bit glyph dsc
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# mmap assets letter A: for xingzhi UI icons/emotes
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS=y
# SPNG/SJPG 图标解码（未开则只能看到文字、触摸重绘易卡死）
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y
# 图片缓存走 ESP heap/PSRAM；512KB 与官方 Korvo1 对齐即可
CONFIG_LV_CACHE_DEF_SIZE=524288
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=64
# 关键：内置 TLSF 仅 64KB，滑动时 lv_draw_buf 反复 alloc 会卡死在 tlsf → IDLE1 WDT。
# 必须改走 CLIB malloc，大块进 PSRAM（与 esp32s31_korvo1/sdkconfig.defaults 一致）。
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=y

# GCC 16 + IDF 6.2: third-party / generated code trips default -Werror=
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
