# grep CONFIG_IDF_TARGET= sdkconfig*
# grep CONFIG_BOARD_TYPE_ sdkconfig*
#
# 换板后若 CMake 缓存混乱：删对应 build-* 再 set-target / build
# rm -rf build-waveshare-1.85b
