# Waveshare 1.85B：8MB Octal PSRAM，内部 SRAM 仅 ~217KB，优先把大块内存放到 PSRAM。
# 构建时使用 -DSDKCONFIG=sdkconfig.waveshare-s3-touch-lcd-1.85b（已合并下列项）。

# malloc：<=256B 才优先内部，其余尽量 SPIRAM；WiFi/LwIP 缓冲已在 PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# NVS / LVGL 栈放 PSRAM
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM=y

# TLS：mbedTLS 堆走 PSRAM；关闭硬件 AES（esp-aes 需内部 DMA，易 Failed to allocate memory）
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
# CONFIG_MBEDTLS_HARDWARE_AES is not set
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
