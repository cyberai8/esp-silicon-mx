# =============================================================================
# esp-yun 编译说明（仅 ESP-Show）
# 仓库: /home/qmx/qmx-sd/esp-yun
#
# 板级: main/boards/esp-show
# Target: esp32s3
# IDF: v5.5.x
# 配置: sdkconfig.esp-show
# =============================================================================

cd /home/qmx/qmx-sd/esp-yun

# 0) 加载 ESP-IDF（路径按本机修改）
source /home/qmx/esp/esp-idf/export.sh
# idf.py --version

# 1) 首次或换 target
idf.py -B build-esp-show \
  -DSDKCONFIG=sdkconfig.esp-show \
  set-target esp32s3

# 2) 编译
idf.py -B build-esp-show \
  -DSDKCONFIG=sdkconfig.esp-show \
  build

# 3) 烧录 + 监视
idf.py -B build-esp-show \
  -DSDKCONFIG=sdkconfig.esp-show \
  -p /dev/ttyACM1 flash monitor

# 4) 合并整片 bin（发版用）
idf.py -B build-esp-show \
  -DSDKCONFIG=sdkconfig.esp-show \
  merge-bin

mkdir -p releases
zip -j releases/v2.0.51_esp-show.zip build-esp-show/merged-binary.bin

# 换板后若 CMake 缓存混乱：删 build 再 set-target / build
# rm -rf build-esp-show
